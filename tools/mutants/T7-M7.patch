 //# received in out-of-order CRYPTO frames.
 /// The number of out-of-order bytes held once `d` at `off` is in.
 pub open spec fn ooo_held(s: CryptoStream, off: u64, d: Seq<u8>) -> nat {
-    ooo_received(s, off, d).len()
+    dup_sum(s.inserted_frames().push((off as nat, d)), rfc_contiguous(rfc_received(s.inserted_frames().push((off as nat, d)))))
+}
+
+pub open spec fn dup_sum(ins: Seq<(nat, Seq<u8>)>, c: nat) -> nat
+    decreases ins.len(),
+{
+    if ins.len() == 0 { 0 } else { dup_sum(ins.drop_last(), c) + if ins.last().0 > c { ins.last().1.len() } else { 0 } }
 }
 
